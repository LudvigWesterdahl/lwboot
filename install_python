#!/bin/sh

installer_name="python"
installer_description="Installs python, documentation and uv."
installer_link="https://wiki.archlinux.org/title/Python"


pacman_pkg1="core/python"
pacman_pkg2="extra/python-docs"
pacman_pkg3="extra/uv"
pacman_pkg4="extra/ty"
pacman_pkg5="extra/ruff"
pacman_pkg6="extra/python-debugpy"
pacman_pkg7="extra/python-pytest"
pacman_pkg8="extra/python-coverage"
pacman_pkg9="extra/python-pytest-cov"

inst_help() {
    htitle "${installer_name}"
    hdesc
    htext "${installer_description}"
    husage
    htext "python"
    hexamples
    htext "Python documentation"
    htext "pythondoc"
    htext
    htext "Uv version"
    htext "uv --version"
    hseealso
    htext "${installer_link}"
    htext
    htext "Python"
    htext "https://archlinux.org/packages/core/x86_64/python/"
    htext
    htext "Python docs"
    htext "https://archlinux.org/packages/extra/any/python-docs/"
    htext
    htext "Uv"
    htext "https://archlinux.org/packages/extra/x86_64/uv/"
    htext
    htext "Ty"
    htext "https://archlinux.org/packages/extra/x86_64/ty/"
    htext
    htext "Ruff"
    htext "https://archlinux.org/packages/extra/x86_64/ruff/"
    htext
    htext "Debugpy"
    htext "https://archlinux.org/packages/extra/x86_64/python-debugpy/"
    htext
    htext "Python pytest"
    htext "https://archlinux.org/packages/extra/any/python-pytest/"
    htext
    htext "Python coverage"
    htext "https://archlinux.org/packages/extra/x86_64/python-coverage/"
    htext
    htext "Python pytest cov"
    htext "https://archlinux.org/packages/extra/any/python-pytest-cov/"
}

inst_is_installed() {
    return 1
}

inst_can_install() {
    return 0
}

inst_install() {
    pacman_install "${pacman_pkg1}"
    pacman_install "${pacman_pkg2}"
    pacman_install "${pacman_pkg3}"
    pacman_install "${pacman_pkg4}"
    pacman_install "${pacman_pkg5}"
    pacman_install "${pacman_pkg6}"
    pacman_install "${pacman_pkg7}"
    pacman_install "${pacman_pkg8}"
    pacman_install "${pacman_pkg9}"
}

inst_can_install_manual() {
    return 1
}

inst_install_manual() {
    return 0
}

inst_uninstall() {
    pacman_uninstall "${pacman_pkg1}"
    pacman_uninstall "${pacman_pkg2}"
    pacman_uninstall "${pacman_pkg3}"
    pacman_uninstall "${pacman_pkg4}"
    pacman_uninstall "${pacman_pkg5}"
    pacman_uninstall "${pacman_pkg6}"
    pacman_uninstall "${pacman_pkg7}"
    pacman_uninstall "${pacman_pkg8}"
    pacman_uninstall "${pacman_pkg9}"
}
